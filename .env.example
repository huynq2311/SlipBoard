# Copy to .env (git-ignored) to configure ./build_release.sh

# Apple team ID used for signing. Leave empty to use the project's team.
DEVELOPMENT_TEAM=

# Name of a self-signed code signing certificate in your keychain, used by the
# default (non --team) build instead of ad-hoc signing. Signing every release
# with the same certificate keeps the Accessibility permission across updates.
# Leave empty for ad-hoc signing.
SIGN_IDENTITY=

# notarytool keychain profile (xcrun notarytool store-credentials ...).
# Only used when the app is signed with a Developer ID certificate.
NOTARY_PROFILE=

# File holding the Sparkle EdDSA private key (generate_keys -x <file>). Leave
# empty to read the key from the login keychain.
SPARKLE_ED_KEY_FILE=
